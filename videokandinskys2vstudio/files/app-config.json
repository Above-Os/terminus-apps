  "workflow": {
    "description": "Kandinsky S2V turns a portrait and a speech recording into a talking video with synced lips, up to two minutes long",
    "file": "flows/s2v.api.json",
    "id": "video_kandinsky_s2v_studio",
    "inputs": [
      {
        "id": "prompt",
        "node": "8",
        "field": "prompt",
        "type": "textarea",
        "label": "Prompt",
        "default": "The video presents a stable medium close-up of a subject facing the camera directly. The subject exhibits natural, lifelike body dynamics: the head and shoulders move fluidly with the rhythm of speech. The lighting is even, maintaining a balanced natural exposure to clearly define facial features without washout. Throughout the sequence, the subject engages in continuous speech marked by precise, high-fidelity articulation. The lips move in a rhythmic, natural pattern: alternating between brief firm closures and relaxed openings. During these openings, the tips of the upper teeth are momentarily and realistically visible, exhibiting natural enamel texture. The upper lip lifts subtly over the teeth during enunciation, while the jaw performs minimal vertical oscillations synchronized with the speech cadence. Facial micro-expressions are active yet restrained; eyebrows rise and lower slightly with minute asymmetry. The eyes maintain a steady, engaged gaze forward, punctuated by smooth, deliberate blinks.",
        "optional": true,
        "role": "prompt"
      },
      {
        "id": "image",
        "node": "4",
        "field": "image",
        "type": "image",
        "label": "Portrait",
        "role": "ref_image"
      },
      {
        "id": "audio",
        "node": "5",
        "field": "audio",
        "type": "audio",
        "label": "Speech",
        "role": "ref_audio"
      },
      {
        "id": "seed",
        "node": "9",
        "field": "seed",
        "type": "seed",
        "label": "Seed",
        "default": 5,
        "random": true,
        "role": "seed"
      }
    ],
    "output": "video",
    "title": "Kandinsky S2V"
  }
