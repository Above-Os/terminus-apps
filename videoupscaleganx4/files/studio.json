{
  "name": "videoupscaleganx4",
  "title": "Real-ESRGAN",
  "flows": [
    {
      "mode": "upscale",
      "label": "Upscale video",
      "output": "video",
      "inputs": [
        {
          "id": "video",
          "node": "14",
          "field": "file",
          "type": "video",
          "label": "Video",
          "role": "source_video"
        }
      ],
      "route": {
        "accepts": {
          "source_video": {
            "max": 1,
            "maxSeconds": 10
          }
        },
        "requiresAny": [
          "source_video"
        ]
      },
      "api": "upscale.api.json",
      "save": "upscale.json"
    },
    {
      "mode": "upscale_image",
      "label": "Upscale image",
      "output": "image",
      "inputs": [
        {
          "id": "image",
          "node": "1",
          "field": "image",
          "type": "image",
          "label": "Image",
          "role": "source_image"
        }
      ],
      "route": {
        "accepts": {
          "source_image": {
            "max": 1
          }
        },
        "requiresAny": [
          "source_image"
        ]
      },
      "api": "upscale_image.api.json",
      "save": "upscale_image.json"
    }
  ],
  "meta": {
    "description": "Real-ESRGAN upscales images and video 4× quickly, with a before/after compare and a short video preview before the whole video runs",
    "icon": "https://cdn.olares.com/images/2026/11/aadd94dc5541a59fa58adab44e705d06.png",
    "provider": "ComfyUI",
    "version": "0.3.0"
  },
  "profile": {
    "tiers": null,
    "strings": {
      "en": {
        "feed.emptyPlain": "Add an image or a video. An image is upscaled at once; a video can be previewed a few seconds first, then upscaled whole.",
        "mode.upscale": "Upscale 4×",
        "mode.upscale_image": "Upscale image 4×"
      },
      "zh": {
        "feed.emptyPlain": "添加一张图片或一段视频。图片直接放大；视频可以先预览几秒对比效果，再放大整段。",
        "mode.upscale": "放大 4 倍",
        "mode.upscale_image": "图片放大 4 倍"
      }
    },
    "composer": "enhance",
    "fixedScale": 4,
    "outputLimit": {
      "default": 8.3
    },
    "outputPixelFrames": {
      "default": 1800
    }
  }
}