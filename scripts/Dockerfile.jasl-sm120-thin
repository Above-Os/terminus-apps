# Thin SM120 image — eric8810-style venv build (NOT upstream multi-stage Dockerfile).
# Pin: jasl/vllm tag sm120-pr-41834-stable-preview-20260804 (0731 + DSpark).
#
# Build with --progress=plain so ninja [N/M] lines are visible in CI logs.

# torch 2.13 ships cu13 — match toolkit (12.8 nvcc fails cooperative_topk PTX).
FROM nvidia/cuda:13.0.2-devel-ubuntu22.04

ARG JASL_REF=9a9c41c0cf4f3f66d3d721f0042fa68ffc2582c1
# 12.0a matches jasl's -gencode arch=compute_120a,code=sm_120a
ARG TORCH_CUDA_ARCH_LIST=12.0a
# Cutlass SM120 nvcc peaks multi‑GiB per job — keep 1 on 16Gi runners (exit 143/OOM at 4).
ARG MAX_JOBS=1
ARG PIP_INDEX_URL=https://pypi.org/simple

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=${MAX_JOBS} \
    CMAKE_BUILD_PARALLEL_LEVEL=${MAX_JOBS} \
    NINJA_STATUS="[%f/%t %es] " \
    CUDA_HOME=/usr/local/cuda \
    PATH=/opt/vllm-venv/bin:/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64 \
    LIBRARY_PATH=/usr/local/cuda/lib64 \
    VIRTUAL_ENV=/opt/vllm-venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    FORCE_CUDA=1 \
    VLLM_USE_FLASHINFER_SAMPLER=0 \
    FLASHINFER_DISABLE_VERSION_CHECK=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.26.0.post1 \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM=0.26.0.post1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3.10-venv python3.10-dev python3-pip \
      git curl ca-certificates \
      build-essential ninja-build cmake \
      pkg-config libnuma-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m venv /opt/vllm-venv \
 && pip install -U pip setuptools wheel ninja cmake \
      'setuptools-scm>=8' setuptools-rust \
      -i "${PIP_INDEX_URL}"

RUN pip install -i "${PIP_INDEX_URL}" \
      --extra-index-url https://flashinfer.ai/whl/ \
      torch==2.13.0 \
      flashinfer-python==0.6.16 \
      flashinfer-cubin==0.6.16

WORKDIR /opt/src
COPY vllm.tgz* /tmp/
RUN set -eux; \
    if ls /tmp/vllm.tgz 1>/dev/null 2>&1; then \
      tar -xzf /tmp/vllm.tgz -C /opt/src; \
    else \
      curl -fL --retry 8 --retry-delay 5 -o /tmp/vllm.tgz \
        "https://codeload.github.com/jasl/vllm/tar.gz/${JASL_REF}" \
      || curl -fL --retry 8 --retry-delay 5 -o /tmp/vllm.tgz \
        "https://ghfast.top/https://github.com/jasl/vllm/archive/${JASL_REF}.tar.gz"; \
      tar -xzf /tmp/vllm.tgz -C /opt/src; \
    fi; \
    mv /opt/src/vllm-* /opt/src/vllm; \
    rm -f /tmp/vllm.tgz

WORKDIR /opt/src/vllm
# stdbuf -oL keeps ninja/pip lines flowing under BuildKit.
RUN printf '__version__ = "0.26.0.post1+sm120.jasl.%s"\n' "${JASL_REF}" > vllm/_version.py \
 && python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'arch', __import__('os').environ.get('TORCH_CUDA_ARCH_LIST'))" \
 && echo "MAX_JOBS=${MAX_JOBS} CMAKE_BUILD_PARALLEL_LEVEL=${CMAKE_BUILD_PARALLEL_LEVEL}" \
 && stdbuf -oL -eL pip install -e . --no-build-isolation -v \
      -i "${PIP_INDEX_URL}" \
      --extra-index-url https://flashinfer.ai/whl/ \
      2>&1 | stdbuf -oL -eL tee /tmp/vllm-build.log \
 && test -x /opt/vllm-venv/bin/vllm

RUN vllm --help >/dev/null && python -c "import vllm; print(vllm.__version__)"

WORKDIR /work
EXPOSE 8000
ENTRYPOINT ["vllm"]
CMD ["--help"]
