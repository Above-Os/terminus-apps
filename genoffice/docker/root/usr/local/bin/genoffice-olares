#!/bin/bash
set -euo pipefail

# Electron in this container has no /dev/dri. --disable-gpu plus
# --disable-software-rasterizer forced the slowest CPU compositor and
# made the Kasm stream feel like a slideshow. SwiftShader is software
# GL with SIMD; /dev/shm is 1Gi so Chromium can use it.
FLAGS=(
  --no-sandbox
  --ozone-platform=x11
  --use-gl=angle
  --use-angle=swiftshader
  --disable-gpu-sandbox
  --in-process-gpu
  --gtk-version=3
)

# Session bus is required for fcitx5 / ibus. Kasm/Openbox often has none.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax)"
fi

export GTK_IM_MODULE="${GTK_IM_MODULE:-fcitx}"
export QT_IM_MODULE="${QT_IM_MODULE:-fcitx}"
export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
export SDL_IM_MODULE="${SDL_IM_MODULE:-fcitx}"

FCITX_HOME="${HOME:-/config}/.config/fcitx5"
mkdir -p "$FCITX_HOME"
if [ ! -f "$FCITX_HOME/profile" ]; then
  cat >"$FCITX_HOME/profile" <<'EOF'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=pinyin

[Groups/0/Items/0]
Name=keyboard-us

[Groups/0/Items/1]
Name=pinyin

[GroupOrder]
0=Default
EOF
fi

if command -v fcitx5 >/dev/null 2>&1; then
  if ! pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
    fcitx5 -d --disable=wayland >/dev/null 2>&1 || true
  fi
  i=0
  while [ "$i" -lt 15 ]; do
    if command -v fcitx5-remote >/dev/null 2>&1 && fcitx5-remote >/dev/null 2>&1; then
      fcitx5-remote -s pinyin >/dev/null 2>&1 || true
      break
    fi
    i=$((i + 1))
    sleep 0.2
  done
fi

BIN=""
for candidate in \
  /opt/GenOffice/genoffice \
  /opt/genoffice/genoffice \
  /usr/bin/genoffice \
  /usr/lib/genoffice/genoffice
do
  if [ -x "$candidate" ]; then
    BIN="$candidate"
    break
  fi
done

if [ -z "$BIN" ]; then
  BIN="$(command -v genoffice || true)"
fi

if [ -z "$BIN" ]; then
  echo "genoffice binary not found" >&2
  find /opt /usr -iname '*genoffice*' 2>/dev/null | head -50 >&2 || true
  sleep infinity
fi

exec "$BIN" "${FLAGS[@]}" "$@"
